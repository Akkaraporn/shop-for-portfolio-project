model webhook_events {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider     String    @db.VarChar(32)
  event_id     String    @db.VarChar(128)
  event_type   String    @db.VarChar(64)
  payload      Json
  received_at  DateTime  @default(now()) @db.Timestamptz(3)
  processed_at DateTime? @db.Timestamptz(3)

  @@unique([provider, event_id], map: "webhook_events_provider_event_key")
}
