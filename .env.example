# ---------------------------------------------------------------------------
# Copy to .env — every value below is a working dev default.
#   cp .env.example .env && make up-node
# ---------------------------------------------------------------------------

# --- Postgres (source of truth) --------------------------------------------
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
# Host-side port only. 5432 is deliberately avoided: a developer with
# PostgreSQL already installed has it bound, and the published port is silently
# shadowed — connections from the host then reach their database instead of this
# one and fail authentication as `shop`, which looks like a credentials bug.
# Inside the compose network the port is always 5432.
POSTGRES_PORT=55432
DATABASE_URL=postgresql://shop:shop@postgres:5432/shop?schema=public

# Same database from the host (prisma db pull, psql, a GUI client).
DATABASE_URL_HOST=postgresql://shop:shop@localhost:55432/shop?schema=public

# --- Application ----------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=1.0.0

# --- Redis (cache / rate limit / sweeper lock; system must survive its loss)
REDIS_URL=redis://redis:6379

# Host-side port, and the URL to use when running a backend outside compose.
REDIS_PORT=56379
REDIS_URL_HOST=redis://localhost:56379

# --- Gateway: the switch between the two backends -------------------------
# make up-node  -> api-node:3000    |    make up-java -> api-java:8080
BACKEND_HOST=api-node
BACKEND_PORT=3000
GATEWAY_PORT=8080

# --- Connection pool ------------------------------------------------------
# 10 per side on purpose. Prisma defaults to cpu*2+1 and HikariCP to 10;
# running both profiles at once on defaults can exhaust max_connections.
DB_POOL_SIZE=10

# --- Auth -----------------------------------------------------------------
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Mock payment provider ------------------------------------------------
PAYMENT_WEBHOOK_SECRET=dev-only-change-me
PAYMENT_MOCK_DELAY_MS=2000

# --- Business rules (fixed on purpose; see README) ------------------------
CURRENCY=THB
SHIPPING_FLAT_CENTS=5000
RESERVATION_TTL_MINUTES=15
